---
interface Props {
	href: string;
	variant?: 'primary' | 'accent' | 'ghost';
	size?: 'md' | 'lg';
	ariaLabel?: string;
}

const { href, variant = 'primary', size = 'md', ariaLabel } = Astro.props;

const variants = {
	primary:
		'bg-primary text-surface hover:bg-primary-dark',
	accent:
		'bg-accent !text-surface hover:bg-accent-hover',
	ghost:
		'bg-transparent text-secondary ring-1 ring-border hover:bg-bg-alt',
};

const sizes = {
	md: 'px-[var(--space-3)] py-[var(--space-2)] text-sm',
	lg: 'px-[var(--space-5)] py-[var(--space-3)] text-base',
};
---

<a
	href={href}
	aria-label={ariaLabel}
	class:list={[
		'inline-flex items-center justify-center rounded-[var(--radius-full)] font-semibold no-underline transition-colors',
		variants[variant],
		sizes[size],
	]}
>
	<slot />
</a>
