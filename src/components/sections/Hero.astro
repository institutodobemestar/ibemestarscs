---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import site from '../../data/site.json';
import heroImage from '../../assets/pages/sobre-nos.png';
---

<section class="hero" aria-labelledby="hero-titulo">
	<Image
		src={heroImage}
		alt="Fisioterapeuta do Instituto do Bem Estar conduzindo alongamento de ombro com paciente, em atendimento individualizado"
		width={heroImage.width}
		height={heroImage.height}
		format="webp"
		quality="mid"
		priority
		loading="eager"
		fetchpriority="high"
		decoding="async"
		class="hero-image"
	/>
	<div class="hero-overlay">
		<div class="hero-copy">
			<p class="hero-badge">Reabilitação em {site.city}</p>
			<h1 id="hero-titulo">
				Recupere sua saúde com o Instituto do
				<span>Bem Estar</span>
			</h1>
			<p class="hero-lead">
				Desde 2007, atendimento personalizado em fisioterapia, acupuntura, hidroterapia e
				reabilitação. Já são mais de 10.000 pacientes acompanhados.
			</p>
			<div class="hero-actions">
				<Button href="#servicos" variant="primary" size="lg">
					Conheça os serviços
					<span aria-hidden="true">→</span>
				</Button>
				<p class="hero-proof">
					<strong>10.000+</strong>
					pacientes atendidos desde 2007
				</p>
			</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		isolation: isolate;
		min-height: 36rem;
		overflow: hidden;
		background: var(--ibe-navy-deep);
	}

	.hero-image {
		position: absolute;
		inset: 0;
		z-index: 0;
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center 18%;
	}

	.hero-overlay {
		position: relative;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		min-height: 36rem;
		padding: 7.5rem var(--space-3) var(--space-7);
		background:
			linear-gradient(90deg, rgb(42 49 64 / 0.88) 0%, rgb(42 49 64 / 0.55) 48%, rgb(42 49 64 / 0.18) 100%);
	}

	.hero-copy {
		max-width: 72rem;
		margin-inline: auto;
		width: 100%;
	}

	.hero-badge {
		display: inline-flex;
		margin: 0;
		padding: 0.4rem 0.9rem;
		border-radius: var(--radius-full);
		background: rgb(255 255 255 / 0.14);
		color: #fff;
		font-size: 0.8125rem;
		font-weight: 600;
	}

	.hero-copy h1 {
		margin: var(--space-3) 0 0;
		max-width: 16ch;
		color: #fff;
	}

	.hero-copy h1 span {
		color: var(--ibe-sage);
	}

	.hero-lead {
		margin: var(--space-3) 0 0;
		max-width: 34rem;
		color: rgb(255 255 255 / 0.86);
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: var(--space-3);
		margin-top: var(--space-5);
	}

	.hero-proof {
		margin: 0;
		color: #fff;
		font-size: 0.9375rem;
	}

	.hero-proof strong {
		display: block;
		font-family: var(--font-serif);
		font-size: 1.25rem;
	}

	@media (min-width: 64rem) {
		.hero,
		.hero-overlay {
			min-height: 42rem;
		}

		.hero-overlay {
			align-items: center;
			padding-block: 8rem var(--space-8);
			padding-inline: var(--space-4);
		}
	}
</style>
