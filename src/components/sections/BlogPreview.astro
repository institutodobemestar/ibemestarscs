---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import { resolveContentImage } from '../../lib/content-images';
import { formatPublishDate } from '../../lib/dates';

interface Props {
	posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
const [featured, ...rest] = posts;
---

{
	posts.length > 0 && (
		<section class="blog" aria-labelledby="blog-home-titulo">
			<Container>
				<SectionHeading
					id="blog-home-titulo"
					align="center"
					eyebrow="Blog"
					title="Orientações de saúde e reabilitação"
				/>
				<ul class="blog-grid">
					{featured && (
						<li class="is-featured">
							<a href={`/blog/${featured.data.slug}/`} class="blog-card is-photo">
								<Image
									src={resolveContentImage(featured.data.heroImage)}
									alt={`Capa do artigo ${featured.data.title}`}
									width={960}
									height={540}
									format="webp"
									quality="mid"
									loading="lazy"
									decoding="async"
									class="blog-image"
								/>
								<div class="blog-body">
									<p>{featured.data.tags[0] ?? 'Artigo'}</p>
									<h3>{featured.data.title}</h3>
									<span>
										Ler artigo
										<span aria-hidden="true"> →</span>
									</span>
								</div>
							</a>
						</li>
					)}
					{rest.map((post) => (
						<li>
							<a href={`/blog/${post.data.slug}/`} class="blog-card">
								<h3>{post.data.title}</h3>
								<p>{post.data.description}</p>
								<span>
									<time datetime={post.data.publishDate.toISOString()}>
										{formatPublishDate(post.data.publishDate)}
									</time>
									· Ler artigo
									<span aria-hidden="true"> →</span>
								</span>
							</a>
						</li>
					))}
				</ul>
			</Container>
		</section>
	)
}

<style>
	.blog {
		padding-block: var(--space-8);
		background: var(--ibe-surface);
	}

	.blog-grid {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.blog-card {
		display: grid;
		align-content: space-between;
		height: 100%;
		min-height: 14rem;
		padding: var(--space-4);
		border-radius: var(--radius-xl);
		background: var(--ibe-bg-alt);
		text-decoration: none;
		color: inherit;
	}

	.blog-card.is-photo {
		position: relative;
		overflow: hidden;
		padding: 0;
		background: var(--ibe-navy-deep);
		color: #fff;
	}

	.blog-image {
		display: block;
		width: 100%;
		height: 16rem;
		object-fit: cover;
	}

	.blog-body {
		position: absolute;
		inset: auto 0 0;
		padding: var(--space-4);
		background: linear-gradient(transparent, rgb(42 49 64 / 0.88));
	}

	.blog-card h3 {
		margin: 0;
		font-size: 1.25rem;
	}

	.blog-card.is-photo h3 {
		color: #fff;
	}

	.blog-card p {
		margin: var(--space-2) 0 0;
		color: var(--color-text-muted);
	}

	.blog-card span {
		margin-top: var(--space-3);
		color: var(--ibe-sage-deep);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.blog-card.is-photo span,
	.blog-card.is-photo p {
		color: var(--ibe-sage);
	}

	@media (min-width: 48rem) {
		.blog-grid {
			grid-template-columns: 1.4fr 1fr 1fr;
		}
	}
</style>
