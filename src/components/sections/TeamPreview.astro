---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Container from '../ui/Container.astro';
import SectionHeading from '../ui/SectionHeading.astro';

interface Props {
	team: CollectionEntry<'team'>[];
}

const { team } = Astro.props;
---

<section class="team" aria-labelledby="equipe-titulo">
	<Container>
		<SectionHeading
			id="equipe-titulo"
			align="center"
			eyebrow="Nossa equipe"
			title="Profissionais de fisioterapia"
			description="Profissionais registrados no CREFITO."
		/>
		<ul class="team-list">
			{
				team.map((member) => (
					<li class="member">
						<Image
							src={member.data.photo}
							alt={`Retrato de ${member.data.name}`}
							width={480}
							height={640}
							format="webp"
							quality="mid"
							loading="lazy"
							decoding="async"
							class="member-photo"
						/>
						<div class="member-copy">
							<h3>{member.data.name}</h3>
							<p class="member-meta">CREFITO {member.data.crefito}</p>
							<p class="member-meta">{member.data.specialties.join(' · ')}</p>
						</div>
					</li>
				))
			}
		</ul>
		<p class="team-more">
			<a href="/equipe/">Conheça toda a equipe</a>
		</p>
	</Container>
</section>

<style>
	.team {
		padding-block: var(--space-8);
		background: var(--ibe-surface);
	}

	.team-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		margin: var(--space-6) 0 0;
		padding: 0;
		list-style: none;
	}

	.member {
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--ibe-bg-alt);
	}

	.member-photo {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center top;
	}

	.member-copy {
		padding: var(--space-3);
	}

	.member h3 {
		margin: 0;
		font-size: 1.35rem;
	}

	.member-meta {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	.team-more {
		margin: var(--space-5) 0 0;
		text-align: center;
	}

	.team-more a {
		color: var(--ibe-sage-deep);
		font-weight: 600;
		text-decoration: none;
	}

	.team-more a:hover,
	.team-more a:focus-visible {
		text-decoration: underline;
	}

	@media (min-width: 48rem) {
		.team-list {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-6);
			max-width: 52rem;
			margin-inline: auto;
		}
	}
</style>
