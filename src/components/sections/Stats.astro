---
import Container from '../ui/Container.astro';

/**
 * Números apenas do conteúdo extraído (sobre-nos, contato, infraestrutura).
 * Não inventar totais ou percentuais.
 */
const stats = [
	{
		value: '2007',
		label: 'Desde este ano em reabilitação de alta qualidade',
	},
	{
		value: '10.000+',
		label: 'Pacientes atendidos ao longo dos anos',
	},
	{
		value: '580 m²',
		label: 'Prédio planejado para conforto e acessibilidade',
	},
	{
		value: '30 m²',
		label: 'Piscina aquecida para hidroterapia',
	},
];
---

<section class="stats" aria-labelledby="stats-titulo">
	<Container>
		<h2 id="stats-titulo" class="sr-only">Números do Instituto do Bem Estar</h2>
		<ul class="stats-grid">
			{
				stats.map((stat) => (
					<li>
						<p class="stats-value">{stat.value}</p>
						<p class="stats-label">{stat.label}</p>
					</li>
				))
			}
		</ul>
	</Container>
</section>

<style>
	.stats {
		background: var(--color-secondary);
		padding-block: var(--space-6);
		color: var(--color-secondary-soft);
	}

	.stats-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.stats-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(2rem, 4vw, 2.75rem);
		font-weight: 600;
		line-height: 1.1;
		color: var(--color-surface);
	}

	.stats-label {
		margin: var(--space-1) 0 0;
		max-width: 16rem;
		font-size: 0.9375rem;
	}

	@media (min-width: 40rem) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.stats-grid {
			grid-template-columns: repeat(4, 1fr);
			gap: var(--space-5);
		}
	}
</style>
