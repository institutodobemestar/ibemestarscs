---
import site from '../../data/site.json';

const items = [
	{ label: 'Prédio planejado', value: '580 m²' },
	{ label: 'Piscina aquecida', value: '30 m²' },
	{ label: 'Desde', value: '2007' },
	{ label: 'Segunda a sexta', value: site.hours.segSex },
];
---

<section class="strip" aria-labelledby="infra-numeros">
	<h2 id="infra-numeros" class="sr-only">Números da infraestrutura</h2>
	<ul>
		{
			items.map((item) => (
				<li>
					<p class="strip-value">{item.value}</p>
					<p class="strip-label">{item.label}</p>
				</li>
			))
		}
	</ul>
</section>

<style>
	.strip {
		background: var(--ibe-navy-deep);
		color: #fff;
	}

	ul {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0;
		max-width: 72rem;
		margin: 0 auto;
		padding: var(--space-5) var(--space-3);
		list-style: none;
	}

	li {
		padding: var(--space-3);
		text-align: center;
	}

	li + li {
		border-top: 1px solid rgb(255 255 255 / 0.08);
	}

	.strip-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 600;
		color: var(--ibe-sage);
	}

	.strip-label {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		color: rgb(255 255 255 / 0.78);
	}

	@media (min-width: 48rem) {
		ul {
			grid-template-columns: repeat(4, minmax(0, 1fr));
			padding-inline: var(--space-4);
		}

		li + li {
			border-top: 0;
			border-left: 1px solid rgb(255 255 255 / 0.08);
		}
	}
</style>
