---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import site from '../../data/site.json';

const whatsappHref = `https://wa.me/${site.whatsapp}`;
---

<section class="cta" aria-labelledby="cta-titulo">
	<Container>
		<div class="cta-panel">
			<p class="cta-eyebrow">Agende uma avaliação</p>
			<h2 id="cta-titulo">Pronto para começar a sua reabilitação?</h2>
			<p>
				Fale com a recepção do {site.name} e agende uma avaliação em {site.city}.
			</p>
			<dl class="hours">
				<div>
					<dt>Segunda a sexta</dt>
					<dd>{site.hours.segSex}</dd>
				</div>
				<div>
					<dt>Sábado</dt>
					<dd>{site.hours.sabado}</dd>
				</div>
				<div>
					<dt>Domingo</dt>
					<dd>{site.hours.domingo}</dd>
				</div>
			</dl>
			<Button href={whatsappHref} variant="primary" size="lg">
				Agende pelo WhatsApp
				<span aria-hidden="true">→</span>
			</Button>
		</div>
	</Container>
</section>

<style>
	.cta {
		background: var(--ibe-navy-deep);
		color: #e8ebf0;
		padding-block: var(--space-8);
	}

	.cta-panel {
		display: grid;
		justify-items: center;
		text-align: center;
	}

	.cta-eyebrow {
		margin: 0;
		color: var(--ibe-sage);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.cta-panel h2 {
		margin: var(--space-2) 0 0;
		max-width: 28rem;
		color: #fff;
	}

	.cta-panel > p {
		margin: var(--space-2) 0 0;
		max-width: 32rem;
		color: rgb(232 235 240 / 0.86);
	}

	.hours {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-3);
		width: min(100%, 36rem);
		margin: var(--space-5) 0;
	}

	.hours dt {
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--ibe-sage);
	}

	.hours dd {
		margin: 0.2rem 0 0;
		font-weight: 600;
		color: #fff;
	}

	@media (min-width: 40rem) {
		.hours {
			grid-template-columns: repeat(3, 1fr);
			gap: 0;
		}

		.hours > div:not(:first-child) {
			padding-left: var(--space-3);
			border-left: 1px solid rgb(255 255 255 / 0.12);
		}
	}
</style>
