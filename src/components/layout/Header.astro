---
import { getCollection } from 'astro:content';
import Logo from '../ui/Logo.astro';
import site from '../../data/site.json';
import { cleanServiceTitle } from '../../lib/services';

const pathname = Astro.url.pathname;
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const whatsappHref = `https://wa.me/${site.whatsapp}`;

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/sobre-nos/', label: 'Sobre Nós' },
	{ href: '/infraestrutura/', label: 'Infraestrutura' },
	{ href: '/equipe/', label: 'Equipe' },
	{ href: '/blog/', label: 'Blog' },
	{ href: '/contato/', label: 'Contato' },
];

function isActive(href: string) {
	if (href === '/') return pathname === '/' || pathname === '';
	const base = href.replace(/\/$/, '');
	return pathname === href || pathname === base || pathname.startsWith(`${base}/`);
}

const servicesActive = pathname === '/servicos' || pathname === '/servicos/' || pathname.startsWith('/servicos/');
---

<header class="site-header">
	<input type="checkbox" id="nav-toggle" class="nav-toggle visually-hidden" />

	<div class="header-bar">
		<a href="/" class="logo" aria-label={`${site.name} — página inicial`}>
			<Logo width={180} height={48} class="header-logo" />
		</a>

		<nav class="nav-desktop" aria-label="Navegação principal">
			<ul class="nav-list">
				{
					links.slice(0, 3).map((link) => (
						<li>
							<a
								href={link.href}
								class:list={['nav-link', isActive(link.href) && 'is-active']}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li class="nav-services">
					<a
						href="/servicos/"
						class:list={['nav-link', servicesActive && 'is-active']}
						aria-current={servicesActive ? 'page' : undefined}
					>
						Serviços
					</a>
					<ul class="nav-dropdown" aria-label="Lista de serviços">
						{
							services.map((service) => (
								<li>
									<a href={`/servicos/${service.data.slug}/`} class="nav-dropdown-link">
										{cleanServiceTitle(service.data.title)}
									</a>
								</li>
							))
						}
					</ul>
				</li>
				{
					links.slice(3).map((link) => (
						<li>
							<a
								href={link.href}
								class:list={['nav-link', isActive(link.href) && 'is-active']}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<a href={whatsappHref} class="header-cta header-cta-desktop">
			Agende agora
			<span aria-hidden="true">→</span>
		</a>

		<label for="nav-toggle" class="nav-toggle-btn">
			<span class="visually-hidden">Abrir menu</span>
			<span class="nav-toggle-icon" aria-hidden="true"></span>
		</label>
	</div>

	<nav id="nav-mobile" class="nav-mobile" aria-label="Navegação principal">
		<div class="nav-mobile-inner">
			<ul class="nav-mobile-list">
				{
					links.slice(0, 3).map((link) => (
						<li>
							<a
								href={link.href}
								class:list={['nav-mobile-link', isActive(link.href) && 'is-active']}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li>
					<details class="nav-mobile-details">
						<summary>Serviços</summary>
						<ul>
							<li>
								<a href="/servicos/" class="nav-mobile-link">
									Todos os serviços
								</a>
							</li>
							{
								services.map((service) => (
									<li>
										<a href={`/servicos/${service.data.slug}/`} class="nav-mobile-link">
											{cleanServiceTitle(service.data.title)}
										</a>
									</li>
								))
							}
						</ul>
					</details>
				</li>
				{
					links.slice(3).map((link) => (
						<li>
							<a
								href={link.href}
								class:list={['nav-mobile-link', isActive(link.href) && 'is-active']}
								aria-current={isActive(link.href) ? 'page' : undefined}
							>
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<a href={whatsappHref} class="header-cta">
				Agende agora
				<span aria-hidden="true">→</span>
			</a>
		</div>
	</nav>
</header>

<style>
	.site-header {
		position: sticky;
		top: 0.75rem;
		z-index: 50;
		margin-bottom: -5.25rem;
		padding-inline: var(--space-2);
		background: transparent;
		border: 0;
		box-shadow: none;
	}

	.nav-toggle {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.header-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		max-width: 72rem;
		margin-inline: auto;
		padding: 0.65rem 0.85rem 0.65rem 1rem;
		border-radius: var(--radius-full);
		background: var(--ibe-surface);
		box-shadow: var(--shadow-md);
	}

	.logo {
		text-decoration: none;
		color: var(--ibe-navy);
		min-width: 0;
	}

	.logo :global(.logo-image) {
		display: block;
		width: auto;
		height: 2.35rem;
	}

	.logo :global(.logo-text) {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.05rem;
		line-height: 1.2;
		letter-spacing: -0.02em;
	}

	.nav-desktop {
		display: none;
	}

	.nav-list,
	.nav-mobile-list,
	.nav-dropdown {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link,
	.nav-mobile-link,
	.nav-dropdown-link {
		font-family: var(--font-sans);
		font-weight: 500;
		text-decoration: none;
		color: var(--ibe-navy);
	}

	.nav-link:hover,
	.nav-dropdown-link:hover,
	.nav-mobile-link:hover,
	.nav-link.is-active,
	.nav-mobile-link.is-active {
		color: var(--ibe-sage-deep);
		text-decoration: none;
		background: transparent;
	}

	.header-cta {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.4rem;
		border-radius: var(--radius-full);
		background: var(--ibe-sage-deep);
		color: #fff;
		font-family: var(--font-sans);
		font-size: 0.875rem;
		font-weight: 600;
		text-decoration: none;
		padding: 0.7rem 1.15rem;
	}

	.header-cta:hover {
		background: var(--ibe-sage-hover);
		color: #fff;
	}

	.header-cta-desktop {
		display: none;
	}

	.nav-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--ibe-border);
		border-radius: var(--radius-full);
		background: transparent;
		cursor: pointer;
	}

	.nav-toggle-icon,
	.nav-toggle-icon::before,
	.nav-toggle-icon::after {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: var(--ibe-navy);
		border-radius: 99px;
		transition: transform 0.25s ease, opacity 0.25s ease;
	}

	.nav-toggle-icon {
		position: relative;
	}

	.nav-toggle-icon::before,
	.nav-toggle-icon::after {
		content: '';
		position: absolute;
		left: 0;
	}

	.nav-toggle-icon::before {
		top: -6px;
	}

	.nav-toggle-icon::after {
		top: 6px;
	}

	.nav-toggle:checked ~ .header-bar .nav-toggle-icon {
		background: transparent;
	}

	.nav-toggle:checked ~ .header-bar .nav-toggle-icon::before {
		transform: translateY(6px) rotate(45deg);
	}

	.nav-toggle:checked ~ .header-bar .nav-toggle-icon::after {
		transform: translateY(-6px) rotate(-45deg);
	}

	.nav-mobile {
		display: grid;
		grid-template-rows: 0fr;
		max-width: 72rem;
		margin: 0.5rem auto 0;
		border-radius: var(--radius-xl);
		background: var(--ibe-surface);
		box-shadow: none;
		transition: grid-template-rows 0.35s ease, box-shadow 0.35s ease;
	}

	.nav-mobile-inner {
		overflow: hidden;
		padding-inline: var(--space-3);
	}

	.nav-toggle:checked ~ .nav-mobile {
		grid-template-rows: 1fr;
		box-shadow: var(--shadow-md);
	}

	.nav-mobile-list {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-block: var(--space-2);
	}

	.nav-mobile-link,
	.nav-mobile-details summary {
		display: block;
		padding-block: var(--space-1);
		color: var(--ibe-navy);
		font-family: var(--font-sans);
		font-weight: 500;
	}

	.nav-mobile-details summary {
		cursor: pointer;
		list-style: none;
	}

	.nav-mobile-details summary::-webkit-details-marker {
		display: none;
	}

	.nav-mobile-details ul {
		list-style: none;
		margin: 0;
		padding: 0 0 var(--space-1) var(--space-2);
	}

	.nav-mobile .header-cta {
		margin-bottom: var(--space-3);
	}

	.nav-toggle:checked ~ .nav-mobile {
		margin-bottom: var(--space-3);
	}

	@media (min-width: 64rem) {
		.site-header {
			padding-inline: var(--space-4);
		}

		.header-bar {
			padding-inline: 1.15rem 0.55rem;
		}

		.logo :global(.logo-image) {
			height: 2.6rem;
		}

		.nav-desktop {
			display: block;
		}

		.nav-list {
			display: flex;
			align-items: center;
			gap: var(--space-3);
		}

		.nav-link {
			font-size: 0.875rem;
		}

		.nav-services {
			position: relative;
		}

		.nav-dropdown {
			position: absolute;
			top: calc(100% + 0.7rem);
			left: 0;
			min-width: 16rem;
			padding: var(--space-1);
			border: 1px solid var(--ibe-border);
			border-radius: var(--radius-lg);
			background: var(--ibe-surface);
			box-shadow: var(--shadow-md);
			opacity: 0;
			visibility: hidden;
			transform: translateY(0.35rem);
			transition:
				opacity 0.2s ease,
				transform 0.2s ease,
				visibility 0.2s ease;
		}

		.nav-services:hover .nav-dropdown,
		.nav-services:focus-within .nav-dropdown {
			opacity: 1;
			visibility: visible;
			transform: translateY(0);
		}

		.nav-dropdown-link {
			display: block;
			padding: 0.55rem 0.75rem;
			border-radius: var(--radius-md);
			font-size: 0.875rem;
		}

		.nav-dropdown-link:hover,
		.nav-dropdown-link:focus-visible {
			background: var(--ibe-primary-soft);
			color: var(--ibe-sage-deep);
		}

		.header-cta-desktop {
			display: inline-flex;
		}

		.nav-toggle-btn {
			position: absolute;
			width: 1px;
			height: 1px;
			padding: 0;
			margin: -1px;
			overflow: hidden;
			clip: rect(0, 0, 0, 0);
			white-space: nowrap;
			border: 0;
		}

		.nav-mobile {
			display: none;
		}
	}
</style>
