---
import { getCollection } from 'astro:content';
import Logo from '../ui/Logo.astro';
import Button from '../ui/Button.astro';
import site from '../../data/site.json';
import { cleanServiceTitle } from '../../lib/services';

const year = new Date().getFullYear();
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const whatsappHref = `https://wa.me/${site.whatsapp}`;

const localBusiness = {
	'@context': 'https://schema.org',
	'@type': 'LocalBusiness',
	name: site.name,
	image: new URL(site.ogImage, Astro.site).href,
	url: Astro.site?.href,
	telephone: site.phone,
	email: site.email,
	address: {
		'@type': 'PostalAddress',
		streetAddress: site.address,
		addressLocality: site.city,
		addressRegion: site.state,
		addressCountry: 'BR',
	},
	openingHoursSpecification: [
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
			opens: '07:30',
			closes: '21:00',
		},
		{
			'@type': 'OpeningHoursSpecification',
			dayOfWeek: 'Saturday',
			opens: '08:00',
			closes: '12:00',
		},
	],
	sameAs: [site.socials.facebook, site.socials.youtube],
	geo: {
		'@type': 'GeoCoordinates',
		latitude: site.geo.latitude,
		longitude: site.geo.longitude,
	},
};
---

<footer class="site-footer">
	<div class="footer-cta">
		<div class="footer-cta-inner">
			<div>
				<p class="footer-cta-eyebrow">Agende uma avaliação</p>
				<h2>Comece o seu projeto de reabilitação</h2>
			</div>
			<Button href={whatsappHref} variant="primary">
				Agende agora
				<span aria-hidden="true">→</span>
			</Button>
		</div>
	</div>

	<div class="footer-grid">
		<div>
			<a href="/" class="footer-brand" aria-label={`${site.name} — página inicial`}>
				<Logo width={180} height={48} class="footer-logo" />
			</a>
			<p class="footer-copy">{site.tagline}.</p>
			<p class="footer-hours">
				<strong>Horário</strong>
				Seg. a sex. {site.hours.segSex}<br />
				Sábado {site.hours.sabado}<br />
				Domingo {site.hours.domingo}
			</p>
		</div>

		<nav aria-label="Links rápidos">
			<p class="footer-heading">Links rápidos</p>
			<ul>
				<li><a href="/">Home</a></li>
				<li><a href="/sobre-nos/">Sobre Nós</a></li>
				<li><a href="/servicos/">Serviços</a></li>
				<li><a href="/equipe/">Equipe</a></li>
				<li><a href="/contato/">Contato</a></li>
			</ul>
		</nav>

		<nav aria-label="Serviços">
			<p class="footer-heading">Serviços</p>
			<ul>
				{
					services.slice(0, 6).map((service) => (
						<li>
							<a href={`/servicos/${service.data.slug}/`}>{cleanServiceTitle(service.data.title)}</a>
						</li>
					))
				}
			</ul>
		</nav>

		<div>
			<p class="footer-heading">Contato</p>
			<ul class="footer-contact">
				<li><a href={`tel:+${site.phoneRaw}`}>{site.phone}</a></li>
				<li><a href={`mailto:${site.email}`}>{site.email}</a></li>
				<li>{site.address}</li>
			</ul>
			<p class="footer-heading footer-heading-spaced">Redes sociais</p>
			<p class="footer-socials">
				<a href={site.socials.facebook}>Facebook</a>
				<a href={site.socials.youtube}>YouTube</a>
			</p>
		</div>
	</div>

	<p class="footer-legal">
		© {year} {site.name}. Todos os direitos reservados.
		<a href="/politica-de-privacidade/">Política de Privacidade</a>
		·
		<a href="/termos-de-uso/">Termos de Uso</a>
	</p>
</footer>

<script type="application/ld+json" set:html={JSON.stringify(localBusiness)} />

<style>
	.site-footer {
		margin-top: 0;
		background: var(--ibe-navy-deep);
		color: #e8ebf0;
	}

	.footer-cta {
		border-bottom: 1px solid rgb(255 255 255 / 0.08);
	}

	.footer-cta-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-3);
		max-width: 72rem;
		margin-inline: auto;
		padding: var(--space-5) var(--space-3);
	}

	.footer-cta-eyebrow {
		margin: 0;
		color: var(--ibe-sage);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.footer-cta h2 {
		margin: 0.35rem 0 0;
		color: #fff;
		font-size: clamp(1.5rem, 3vw, 2rem);
	}

	.footer-grid {
		display: grid;
		gap: var(--space-5);
		max-width: 72rem;
		margin-inline: auto;
		padding: var(--space-7) var(--space-3) var(--space-6);
	}

	.footer-brand {
		display: inline-flex;
		padding: 0.45rem 0.7rem;
		border-radius: var(--radius-md);
		background: #fff;
		text-decoration: none;
	}

	.footer-brand :global(.logo-image) {
		display: block;
		width: auto;
		height: 2.5rem;
	}

	.footer-copy,
	.footer-hours,
	.footer-contact,
	.footer-grid p {
		margin: 0;
		line-height: 1.6;
		color: rgb(232 235 240 / 0.82);
	}

	.footer-copy {
		margin-top: var(--space-3);
		max-width: 22rem;
	}

	.footer-hours {
		margin-top: var(--space-3);
		font-size: 0.9375rem;
	}

	.footer-hours strong {
		display: block;
		margin-bottom: 0.35rem;
		color: #fff;
	}

	.footer-heading {
		margin: 0 0 var(--space-2);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 600;
		color: #fff;
	}

	.footer-heading-spaced {
		margin-top: var(--space-4);
	}

	.footer-grid ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.55rem;
	}

	.footer-grid a {
		color: rgb(232 235 240 / 0.82);
		text-decoration: none;
	}

	.footer-grid a:hover {
		color: var(--ibe-sage);
	}

	.footer-socials {
		display: flex;
		gap: var(--space-2);
	}

	.footer-legal {
		margin: 0;
		border-top: 1px solid rgb(255 255 255 / 0.08);
		padding: var(--space-3);
		text-align: center;
		font-size: 0.75rem;
		color: rgb(232 235 240 / 0.7);
	}

	.footer-legal a {
		color: inherit;
		text-decoration: none;
	}

	.footer-legal a:hover {
		color: var(--ibe-sage);
	}

	@media (min-width: 48rem) {
		.footer-cta-inner,
		.footer-grid {
			padding-inline: var(--space-4);
		}

		.footer-grid {
			grid-template-columns: 1.4fr 1fr 1.1fr 1.2fr;
			gap: var(--space-6);
		}
	}
</style>
