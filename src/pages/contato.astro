---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import ContactInfo from '../components/ui/ContactInfo.astro';
import Button from '../components/ui/Button.astro';
import site from '../data/site.json';

const whatsappHref = `https://wa.me/${site.whatsapp}`;
const mapsQuery = encodeURIComponent(site.address);
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&hl=pt-BR&z=16&output=embed`;
const mapsLink = 'https://maps.app.goo.gl/za59ZjuYxn6vnBh39';
---

<BaseLayout
	title="Contato - Instituto do Bem Estar"
	description={`Fale com o Instituto do Bem Estar: ${site.phone}, ${site.address}.`}
	canonical="/contato"
>
	<section class="page" aria-labelledby="contato-titulo">
		<Container>
			<Breadcrumb
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Contato', href: '/contato' },
				]}
			/>
			<h1 id="contato-titulo">Contato</h1>
			<p class="lead">Gostaríamos muito de ouvir você! Sinta-se à vontade para nos deixar uma mensagem.</p>

			<div class="grid">
				<div>
					<h2>Informações</h2>
					<ContactInfo />
					<div class="cta">
						<Button href={whatsappHref} variant="accent" size="lg">
							Fale pelo WhatsApp
						</Button>
					</div>
				</div>

				<div>
					<h2>Como chegar</h2>
					<iframe
						class="map"
						title={`Mapa com a localização do ${site.name} em ${site.city}`}
						src={mapsEmbed}
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>
					<p class="map-fallback">
						<a href={mapsLink} target="_blank" rel="noopener noreferrer">Ver no Google Maps</a>
					</p>
				</div>
			</div>

			<section class="notes" aria-labelledby="acesso-titulo">
				<h2 id="acesso-titulo">Acesso e ambiente</h2>
				<ul>
					<li>
						<h3>Fácil acesso</h3>
						<p>
							Localizado em uma área central de fácil acesso, com estacionamento disponível para
							nossos pacientes.
						</p>
					</li>
					<li>
						<h3>Ambiente acolhedor</h3>
						<p>
							Nosso prédio de 580m² foi planejado para proporcionar o máximo conforto e
							acessibilidade aos nossos pacientes.
						</p>
					</li>
				</ul>
			</section>
		</Container>
	</section>
</BaseLayout>

<style>
	.page {
		padding-block: var(--space-7);
	}

	.page h1 {
		margin: 0;
		font-size: clamp(2rem, 4vw, 2.75rem);
	}

	.lead {
		margin: var(--space-3) 0 var(--space-6);
		max-width: 40rem;
		font-size: 1.125rem;
		color: var(--color-text-muted);
	}

	.grid {
		display: grid;
		gap: var(--space-6);
	}

	.grid h2,
	.notes h2 {
		margin: 0 0 var(--space-3);
		font-size: 1.5rem;
	}

	.cta {
		margin-top: var(--space-5);
	}

	.map {
		display: block;
		width: 100%;
		min-height: 20rem;
		border: 0;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
	}

	.map-fallback {
		margin: var(--space-2) 0 0;
	}

	.map-fallback a {
		color: var(--color-primary-dark);
		font-weight: 600;
		text-decoration: none;
	}

	.map-fallback a:hover {
		text-decoration: underline;
	}

	.notes {
		margin-top: var(--space-7);
	}

	.notes ul {
		display: grid;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.notes li {
		padding: var(--space-4);
		border-radius: var(--radius-lg);
		background: var(--color-bg-alt);
	}

	.notes h3 {
		margin: 0 0 var(--space-2);
		font-size: 1.15rem;
	}

	.notes p {
		margin: 0;
		color: var(--color-text-muted);
	}

	@media (min-width: 48rem) {
		.grid {
			grid-template-columns: 1fr 1.1fr;
			align-items: start;
		}

		.notes ul {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
