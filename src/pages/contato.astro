---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PageHero from '../components/ui/PageHero.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import ContactInfo from '../components/ui/ContactInfo.astro';
import AppointmentForm from '../components/sections/AppointmentForm.astro';
import site from '../data/site.json';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const mapsQuery = encodeURIComponent(site.address);
const mapsEmbed = `https://www.google.com/maps?q=${mapsQuery}&hl=pt-BR&z=16&output=embed`;
const mapsLink = 'https://maps.app.goo.gl/za59ZjuYxn6vnBh39';
---

<BaseLayout
	title="Contato - Instituto do Bem Estar"
	description={`Fale com o Instituto do Bem Estar: ${site.phone}, ${site.address}.`}
	canonical="/contato/"
>
	<PageHero id="contato-titulo" title="Contato" tone="dark">
		<Breadcrumb
			slot="breadcrumb"
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Contato', href: '/contato/' },
			]}
		/>
	</PageHero>

	<section class="contact" aria-labelledby="contato-info">
		<Container>
			<div class="contact-grid">
				<div>
					<SectionHeading
						id="contato-info"
						eyebrow="Contato"
						title="Fale com a nossa equipe"
						description={`Use o WhatsApp, o telefone ou o formulário para agendar uma avaliação em ${site.city}.`}
					/>
					<ContactInfo />
				</div>
				<AppointmentForm
					services={services}
					formId="contato-whatsapp"
					variant="card"
					title="Entre em contato"
					description="Preencha os dados. Vamos abrir o WhatsApp da recepção com a sua mensagem pronta."
				/>
			</div>
		</Container>
	</section>

	<section class="location" aria-labelledby="local-titulo">
		<Container>
			<SectionHeading
				id="local-titulo"
				align="center"
				eyebrow="Localização"
				title="Onde estamos"
				description={`${site.address}. Prédio de 580 m², com acessibilidade e estacionamento para pacientes.`}
			/>
			<iframe
				class="map"
				title={`Mapa com a localização do ${site.name} em ${site.city}`}
				src={mapsEmbed}
				loading="lazy"
				referrerpolicy="no-referrer-when-downgrade"
				allowfullscreen
			></iframe>
			<p class="map-fallback">
				<a href={mapsLink} target="_blank" rel="noopener noreferrer">
					Ver no Google Maps
					<span aria-hidden="true">→</span>
				</a>
			</p>
		</Container>
	</section>
</BaseLayout>

<style>
	.contact,
	.location {
		padding-block: var(--space-8);
		background: var(--ibe-surface);
	}

	.contact-grid {
		display: grid;
		gap: var(--space-6);
		align-items: start;
	}

	.contact-grid :global(.contact-info) {
		margin-top: var(--space-5);
	}

	.map {
		display: block;
		width: 100%;
		min-height: 22rem;
		margin-top: var(--space-5);
		border: 0;
		border-radius: var(--radius-xl);
		background: var(--ibe-bg-alt);
	}

	.map-fallback {
		margin: var(--space-3) 0 0;
		text-align: center;
	}

	.map-fallback a {
		color: var(--ibe-sage-deep);
		font-weight: 600;
		text-decoration: none;
	}

	.map-fallback a:hover {
		text-decoration: underline;
	}

	@media (min-width: 64rem) {
		.contact-grid {
			grid-template-columns: 1fr 1fr;
			gap: var(--space-8);
		}

		.map {
			min-height: 28rem;
		}
	}
</style>
