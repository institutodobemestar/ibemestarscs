---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import PageHero from '../../components/ui/PageHero.astro';
import site from '../../data/site.json';
import faqs from '../../data/faqs.json';
import { resolveContentImage } from '../../lib/content-images';
import { cleanServiceTitle, getServiceDetails } from '../../lib/services';

export async function getStaticPaths() {
	const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
	return services.map((service) => ({
		params: { slug: service.data.slug },
		props: { service, services },
	}));
}

const { service, services } = Astro.props;
const title = cleanServiceTitle(service.data.title);
const details = getServiceDetails(service.data.slug);
const heroImage = resolveContentImage(service.data.heroImage);
const benefits = details?.benefits?.length ? details.benefits : service.data.indications;
const highlights = details?.highlights ?? [];

const highlightIcons = [
	'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>',
	'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="8" r="3"/><path d="M5 19c.8-3.2 3.4-5 7-5s6.2 1.8 7 5"/></svg>',
	'<svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M7 4h10v16H7z"/><path d="M10 8h4M10 12h4M10 16h2"/></svg>',
];

const medicalTherapy = {
	'@context': 'https://schema.org',
	'@type': 'MedicalTherapy',
	name: title,
	description: service.data.shortDescription,
	url: new URL(`/servicos/${service.data.slug}/`, Astro.site).href,
	provider: {
		'@type': 'Organization',
		name: site.name,
		url: Astro.site?.href,
	},
};
---

<BaseLayout
	title={`${title} - Instituto do Bem Estar`}
	description={service.data.shortDescription}
	ogImage={service.data.heroImage}
	canonical={`/servicos/${service.data.slug}/`}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(medicalTherapy)} />
	</Fragment>

	<article>
		<PageHero id="servico-titulo" title={title} tone="dark">
			<Breadcrumb
				slot="breadcrumb"
				items={[
					{ label: 'Home', href: '/' },
					{ label: 'Serviços', href: '/servicos/' },
					{ label: title, href: `/servicos/${service.data.slug}/` },
				]}
			/>
		</PageHero>

		<section class="service-page" aria-labelledby="servico-titulo">
			<Container>
				<div class="service-layout">
					<aside class="service-aside">
						<nav class="explore" aria-label="Lista de serviços">
							<p class="explore-title">Explore nossos serviços</p>
							<ul>
								{
									services.map((item) => {
										const itemTitle = cleanServiceTitle(item.data.title);
										const current = item.data.slug === service.data.slug;
										return (
											<li class:list={[current && 'is-current']}>
												<a
													href={`/servicos/${item.data.slug}/`}
													aria-current={current ? 'page' : undefined}
												>
													<span>{itemTitle}</span>
													<svg viewBox="0 0 24 24" aria-hidden="true">
														<path d="m9 6 6 6-6 6" />
													</svg>
												</a>
											</li>
										);
									})
								}
							</ul>
						</nav>
					</aside>

					<div class="service-content">
						<figure class="service-photo">
							<Image
								src={heroImage}
								alt={`Imagem do serviço ${title} no Instituto do Bem Estar`}
								width={1200}
								height={800}
								format="webp"
								quality="mid"
								priority
								loading="eager"
								fetchpriority="high"
								decoding="async"
								class="service-image"
							/>
						</figure>

						{
							benefits.length > 0 && (
								<section class="benefits" aria-labelledby="beneficios-titulo">
									<h2 id="beneficios-titulo">{details?.benefitsTitle ?? `Benefícios da ${title}`}</h2>
									<p>{details?.benefitsLead ?? service.data.shortDescription}</p>
									<ul>
										{benefits.map((item) => (
											<li>
												<span class="check" aria-hidden="true">
													<svg viewBox="0 0 24 24">
														<path d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4-10 10Z" />
													</svg>
												</span>
												<span>{item}</span>
											</li>
										))}
									</ul>
								</section>
							)
						}

						{
							highlights.length > 0 && (
								<section class="highlights" aria-labelledby="sessao-titulo">
									<h2 id="sessao-titulo">{details?.highlightsTitle ?? 'Como é a sessão'}</h2>
									{details?.highlightsLead && <p>{details.highlightsLead}</p>}
									<ul>
										{highlights.map((item, index) => (
											<li>
												<span
													class="highlight-icon"
													aria-hidden="true"
													set:html={highlightIcons[index] ?? highlightIcons[0]}
												/>
												<h3>{item.title}</h3>
												<p>{item.text}</p>
											</li>
										))}
									</ul>
								</section>
							)
						}

						<section class="faq" aria-labelledby="faq-servico-titulo">
							<h2 id="faq-servico-titulo">Perguntas frequentes</h2>
							<div class="faq-list">
								{
									faqs.map((item, index) => (
										<details class="faq-item" open={index === 0}>
											<summary>{item.question}</summary>
											<p>{item.answer}</p>
										</details>
									))
								}
							</div>
						</section>
					</div>
				</div>
			</Container>
		</section>
	</article>
</BaseLayout>

<style>
	.service-page {
		padding-block: var(--space-7) var(--space-8);
		background: var(--ibe-surface);
	}

	.service-layout {
		display: grid;
		gap: var(--space-5);
	}

	.explore {
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--ibe-surface);
		box-shadow: var(--shadow-md);
	}

	.explore-title {
		margin: 0;
		padding: 1.05rem 1.25rem;
		background: var(--ibe-sage-deep);
		color: #fff;
		font-size: 1.05rem;
		font-weight: 700;
	}

	.explore ul {
		margin: 0;
		padding: 0.35rem 0;
		list-style: none;
	}

	.explore a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		padding: 0.95rem 1.15rem;
		color: var(--ibe-navy);
		font-weight: 600;
		text-decoration: none;
		border-top: 1px solid var(--ibe-border);
	}

	.explore li:first-child a {
		border-top: 0;
	}

	.explore svg {
		flex-shrink: 0;
		width: 1rem;
		height: 1rem;
		stroke: currentColor;
		stroke-width: 2;
		fill: none;
	}

	.explore a:hover {
		background: var(--ibe-primary-soft);
		color: var(--ibe-sage-deep);
	}

	.explore .is-current a {
		background: var(--ibe-sage);
		color: var(--ibe-navy);
	}

	.service-content {
		display: grid;
		gap: var(--space-6);
		min-width: 0;
	}

	.service-photo {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-xl);
	}

	.service-image {
		display: block;
		width: 100%;
		height: auto;
		max-height: 32rem;
		object-fit: cover;
	}

	.benefits h2,
	.highlights h2,
	.faq h2 {
		margin: 0;
		text-align: center;
		font-size: clamp(1.75rem, 3vw, 2.25rem);
	}

	.benefits > p,
	.highlights > p {
		margin: var(--space-2) auto 0;
		max-width: 40rem;
		text-align: center;
		color: var(--color-text-muted);
	}

	.benefits ul {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.benefits li {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
		color: var(--ibe-navy);
		font-weight: 600;
	}

	.check {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		border-radius: var(--radius-full);
		background: var(--ibe-sage-deep);
	}

	.check svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: #fff;
	}

	.highlights ul {
		display: grid;
		gap: var(--space-4);
		margin: var(--space-5) 0 0;
		padding: 0;
		list-style: none;
	}

	.highlights li {
		text-align: center;
	}

	.highlight-icon {
		display: grid;
		place-items: center;
		width: 4.25rem;
		height: 4.25rem;
		margin: 0 auto var(--space-2);
		border: 1px dashed var(--ibe-sage-deep);
		border-radius: var(--radius-full);
		color: var(--ibe-sage-deep);
	}

	.highlight-icon :global(svg) {
		display: block;
		width: 2rem;
		height: 2rem;
	}

	.highlights h3 {
		margin: 0;
		font-size: 1.15rem;
	}

	.highlights li p {
		margin: 0.45rem 0 0;
		color: var(--color-text-muted);
	}

	.faq-list {
		max-width: 40rem;
		margin: var(--space-5) auto 0;
	}

	.faq-item {
		border-bottom: 1px solid var(--ibe-border);
		padding-block: var(--space-3);
	}

	.faq-item summary {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: var(--space-2);
		cursor: pointer;
		font-weight: 700;
		color: var(--ibe-navy);
		list-style: none;
	}

	.faq-item summary::-webkit-details-marker {
		display: none;
	}

	.faq-item summary::after {
		content: '+';
		flex-shrink: 0;
		color: var(--ibe-sage-deep);
		font-size: 1.35rem;
		font-weight: 500;
		line-height: 1;
	}

	.faq-item[open] summary::after {
		content: '–';
	}

	.faq-item p {
		margin: var(--space-2) 0 0;
		color: var(--color-text-muted);
	}

	@media (min-width: 48rem) {
		.benefits ul {
			grid-template-columns: 1fr 1fr;
			column-gap: var(--space-5);
		}

		.highlights ul {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.service-layout {
			grid-template-columns: 18.5rem minmax(0, 1fr);
			align-items: start;
			gap: var(--space-6);
		}

		.service-aside {
			position: sticky;
			top: 7rem;
		}
	}
</style>
