---
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import ServiceCards from '../../components/ui/ServiceCards.astro';
import site from '../../data/site.json';
import { resolveContentImage } from '../../lib/content-images';
import { cleanServiceTitle } from '../../lib/services';

export async function getStaticPaths() {
	const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
	return services.map((service) => ({
		params: { slug: service.data.slug },
		props: { service, services },
	}));
}

const { service, services } = Astro.props;
const { Content } = await render(service);
const title = cleanServiceTitle(service.data.title);
const otherServices = services.filter((item) => item.data.slug !== service.data.slug);
const hasIndications = service.data.indications.length > 0;
const whatsappHref = `https://wa.me/${site.whatsapp}?text=${encodeURIComponent(
	`Olá, gostaria de agendar uma consulta de ${title} no Instituto do Bem Estar.`,
)}`;

const medicalTherapy = {
	'@context': 'https://schema.org',
	'@type': 'MedicalTherapy',
	name: title,
	description: service.data.shortDescription,
	url: new URL(`/servicos/${service.data.slug}`, Astro.site).href,
	provider: {
		'@type': 'Organization',
		name: site.name,
		url: Astro.site?.href,
	},
};
---

<BaseLayout
	title={`${title} - Instituto do Bem Estar`}
	description={service.data.shortDescription}
	ogImage={service.data.heroImage}
	canonical={`/servicos/${service.data.slug}`}
>
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(medicalTherapy)} />
	</Fragment>

	<article>
		<header class="service-hero">
			<Container>
				<Breadcrumb
					items={[
						{ label: 'Home', href: '/' },
						{ label: 'Serviços', href: '/servicos' },
						{ label: title, href: `/servicos/${service.data.slug}` },
					]}
				/>
				<div class="hero-grid">
					<div>
						<p class="eyebrow">Serviço</p>
						<h1>{title}</h1>
						<p class="lead">{service.data.shortDescription}</p>
					</div>
					<figure>
						<Image
							src={resolveContentImage(service.data.heroImage)}
							alt={`Imagem do serviço ${title} no Instituto do Bem Estar`}
							width={1200}
							height={800}
							format="webp"
							quality="mid"
							priority
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="hero-image"
						/>
					</figure>
				</div>
			</Container>
		</header>

		<Container class="service-body">
			<div class="article-body">
				<Content />
			</div>

			{
				hasIndications && (
					<section class="indications" aria-labelledby="indicacoes-titulo">
						<h2 id="indicacoes-titulo">Indicações</h2>
						<ul>
							{service.data.indications.map((item) => (
								<li>
									<svg viewBox="0 0 24 24" aria-hidden="true">
										<path d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4-10 10Z" />
									</svg>
									<span>{item}</span>
								</li>
							))}
						</ul>
					</section>
				)
			}

			<div class="cta">
				<Button href={whatsappHref} variant="accent" size="lg">
					Agende uma consulta de {title}
				</Button>
			</div>
		</Container>
	</article>

	{
		otherServices.length > 0 && (
			<section class="others" aria-labelledby="outros-servicos">
				<Container>
					<h2 id="outros-servicos">Outros serviços</h2>
					<ServiceCards services={otherServices} variant="compact" />
				</Container>
			</section>
		)
	}
</BaseLayout>

<style>
	.service-hero {
		background: var(--color-bg-alt);
		padding-block: var(--space-6);
	}

	.hero-grid {
		display: grid;
		align-items: center;
		gap: var(--space-5);
	}

	.eyebrow {
		margin: 0;
		font-size: 0.875rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-primary-dark);
	}

	.service-hero h1 {
		margin: var(--space-2) 0 0;
		font-size: clamp(2rem, 4vw, 3rem);
	}

	.lead {
		margin: var(--space-3) 0 0;
		font-size: 1.125rem;
		color: var(--color-text-muted);
	}

	.service-hero figure {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-xl);
		box-shadow: var(--shadow-md);
	}

	.hero-image {
		display: block;
		width: 100%;
		height: auto;
		object-fit: cover;
	}

	.service-body {
		padding-block: var(--space-7);
	}

	.article-body {
		max-width: 48rem;
	}

	.indications {
		margin-top: var(--space-6);
	}

	.indications h2 {
		margin: 0 0 var(--space-3);
		font-size: 1.5rem;
	}

	.indications ul {
		display: grid;
		gap: var(--space-2);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.indications li {
		display: flex;
		align-items: flex-start;
		gap: var(--space-2);
		padding: var(--space-2) var(--space-3);
		border-radius: var(--radius-md);
		background: var(--color-primary-soft);
		color: var(--color-primary-dark);
	}

	.indications svg {
		flex-shrink: 0;
		width: 1.25rem;
		height: 1.25rem;
		margin-top: 0.15rem;
		fill: var(--color-primary-dark);
	}

	.cta {
		margin-top: var(--space-6);
	}

	.others {
		padding-block: 0 var(--space-8);
	}

	.others h2 {
		margin: 0 0 var(--space-4);
		font-size: 1.75rem;
	}

	@media (min-width: 48rem) {
		.hero-grid {
			grid-template-columns: 1fr 1fr;
		}

		.indications ul {
			grid-template-columns: 1fr 1fr;
		}
	}
</style>
