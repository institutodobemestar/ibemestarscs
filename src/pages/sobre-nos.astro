---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PageHero from '../components/ui/PageHero.astro';
import Button from '../components/ui/Button.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import VideoBanner from '../components/sections/VideoBanner.astro';
import FaqSection from '../components/sections/FaqSection.astro';
import Testimonials from '../components/sections/Testimonials.astro';
import site from '../data/site.json';
import heroImage from '../assets/pages/sobre-nos.png';
import spaceImage from '../assets/pages/infraestrutura.jpg';

const team = await getCollection('team');
const testimonials = (await getCollection('testimonials')).slice(0, 3);
const director = team.find((member) => member.id.includes('daniele')) ?? team[0];
const whatsappHref = `https://wa.me/${site.whatsapp}`;

const checks = [
	{
		title: 'Atendimento personalizado',
		text: 'Cada paciente recebe um tratamento adaptado às suas necessidades específicas.',
	},
	{
		title: 'Infraestrutura de ponta',
		text: 'Prédio de 580 m² planejado para conforto, acessibilidade e eficácia clínica.',
	},
];

const pillars = [
	{
		title: 'Missão',
		text: 'Construir e realizar projetos integrativos de reabilitação, entregando com excelência resultados sustentáveis e duradouros.',
	},
	{
		title: 'Visão',
		text: 'Levar bem-estar e qualidade de vida a todos que nos procuram, com terapias integrativas para a saúde física, mental e espiritual.',
	},
];

const facts = [
	{ value: '2007', label: 'Ano de fundação' },
	{ value: '+10.000', label: 'Pacientes atendidos' },
	{ value: '580 m²', label: 'Prédio planejado' },
	{ value: '30 m²', label: 'Piscina aquecida' },
];
---

<BaseLayout
	title="Sobre Nós - Instituto do Bem Estar"
	description="Desde 2007, o Instituto do Bem Estar oferece reabilitação de alta qualidade em São Caetano do Sul, com atendimento personalizado e mais de 10.000 pacientes atendidos."
	canonical="/sobre-nos/"
>
	<PageHero id="sobre-titulo" title="Sobre Nós" tone="dark">
		<Breadcrumb
			slot="breadcrumb"
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Sobre Nós', href: '/sobre-nos/' },
			]}
		/>
	</PageHero>

	<section class="intro" aria-labelledby="intro-titulo">
		<Container>
			<div class="intro-grid">
				<div class="intro-media">
					<figure class="intro-main">
						<Image
							src={heroImage}
							alt="Fisioterapeuta do Instituto do Bem Estar em atendimento individualizado com paciente"
							width={heroImage.width}
							height={heroImage.height}
							format="webp"
							quality="mid"
							priority
							loading="eager"
							fetchpriority="high"
							decoding="async"
							class="intro-photo"
						/>
					</figure>
					<figure class="intro-secondary">
						<Image
							src={spaceImage}
							alt="Sala de reabilitação do Instituto do Bem Estar"
							width={spaceImage.width}
							height={spaceImage.height}
							format="webp"
							quality="mid"
							loading="lazy"
							decoding="async"
							class="intro-photo"
						/>
					</figure>
					<p class="intro-badge">
						<strong>Desde 2007</strong>
						<span>Reabilitação em São Caetano do Sul</span>
					</p>
				</div>

				<div class="intro-copy">
					<SectionHeading
						id="intro-titulo"
						eyebrow="Instituto do Bem Estar"
						title="Cuidado clínico com expertise e acolhimento"
						description="Desde 2007, o Instituto do Bem Estar oferece tratamentos de reabilitação de alta qualidade, com atendimento personalizado e mais de 10.000 pacientes acompanhados."
					/>
					<ul class="intro-checks">
						{
							checks.map((item) => (
								<li>
									<span class="check" aria-hidden="true">
										<svg viewBox="0 0 24 24">
											<path d="M9.2 16.6 4.8 12.2l1.4-1.4 3 3 8.6-8.6 1.4 1.4-10 10Z" />
										</svg>
									</span>
									<div>
										<strong>{item.title}</strong>
										<p>{item.text}</p>
									</div>
								</li>
							))
						}
					</ul>
					{
						director && (
							<div class="intro-director">
								<Image
									src={director.data.photo}
									alt={`Retrato de ${director.data.name}`}
									width={120}
									height={120}
									format="webp"
									quality="mid"
									loading="lazy"
									decoding="async"
									class="director-photo"
								/>
								<div>
									<p class="director-name">{director.data.name}</p>
									<p class="director-meta">Diretora · CREFITO {director.data.crefito}</p>
								</div>
							</div>
						)
					}
					<Button href="/equipe/" variant="primary">
						Conheça a equipe
						<span aria-hidden="true">→</span>
					</Button>
				</div>
			</div>
		</Container>
	</section>

	<section class="pillars" aria-labelledby="pilares-titulo">
		<Container>
			<SectionHeading
				id="pilares-titulo"
				align="center"
				eyebrow="Quem somos"
				title="Reabilitação para qualidade de vida"
				description="Valores que orientam o Instituto: competência, respeito, ética, compaixão e amor."
			/>
			<div class="pillars-grid">
				{
					pillars.map((item) => (
						<article class="pillar-card">
							<h3>{item.title}</h3>
							<p>{item.text}</p>
						</article>
					))
				}
				<article class="pillar-panel">
					<p class="panel-eyebrow">Agende uma avaliação</p>
					<h3>Fale com a recepção</h3>
					<p>
						Segunda a sexta, {site.hours.segSex}. Sábado, {site.hours.sabado}.
					</p>
					<a class="panel-phone" href={`tel:+${site.phoneRaw}`}>
						{site.phone}
					</a>
					<Button href={whatsappHref} variant="primary">
						WhatsApp
						<span aria-hidden="true">→</span>
					</Button>
				</article>
			</div>
		</Container>
	</section>

	<section class="facts" aria-labelledby="numeros-titulo">
		<Container>
			<div class="facts-grid">
				<figure class="facts-media">
					<Image
						src={spaceImage}
						alt="Estrutura de reabilitação do Instituto do Bem Estar em São Caetano do Sul"
						width={spaceImage.width}
						height={spaceImage.height}
						format="webp"
						quality="mid"
						loading="lazy"
						decoding="async"
						class="facts-photo"
					/>
				</figure>
				<div>
					<SectionHeading
						id="numeros-titulo"
						eyebrow="Nossa estrutura"
						title="Números da clínica"
						description="Dados reais da infraestrutura e da trajetória do Instituto do Bem Estar."
					/>
					<ul class="facts-list">
						{
							facts.map((item) => (
								<li>
									<p class="facts-value">{item.value}</p>
									<p class="facts-label">{item.label}</p>
								</li>
							))
						}
					</ul>
					<Button href="/infraestrutura/" variant="primary">
						Conheça a infraestrutura
						<span aria-hidden="true">→</span>
					</Button>
				</div>
			</div>
		</Container>
	</section>

	<VideoBanner title="Reabilitação com estrutura e cuidado em cada detalhe" />

	<FaqSection
		variant="centered"
		eyebrow="Perguntas frequentes"
		title="Tudo o que você precisa saber sobre nós"
	/>

	<Testimonials testimonials={testimonials} />
</BaseLayout>

<style>
	.intro,
	.pillars,
	.facts {
		padding-block: var(--space-8);
	}

	.intro,
	.facts {
		background: var(--ibe-surface);
	}

	.pillars {
		background: var(--ibe-bg-alt);
	}

	.intro-grid,
	.facts-grid,
	.pillars-grid {
		display: grid;
		gap: var(--space-6);
	}

	.intro-media {
		position: relative;
		min-height: 22rem;
	}

	.intro-main,
	.intro-secondary,
	.facts-media {
		margin: 0;
		overflow: hidden;
		border-radius: var(--radius-xl);
	}

	.intro-main {
		width: min(100%, 28rem);
		margin-left: auto;
	}

	.intro-photo,
	.facts-photo {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.intro-main .intro-photo {
		aspect-ratio: 4 / 5;
		object-position: center 18%;
	}

	.intro-secondary {
		display: none;
	}

	.intro-badge {
		position: absolute;
		left: 0;
		bottom: 1.25rem;
		z-index: 1;
		display: grid;
		width: min(100%, 14rem);
		margin: 0;
		padding: var(--space-3);
		border-radius: var(--radius-lg);
		background: var(--ibe-surface);
		box-shadow: var(--shadow-md);
	}

	.intro-badge strong {
		color: var(--ibe-sage-deep);
		font-size: 1.35rem;
	}

	.intro-badge span {
		color: var(--color-text-muted);
		font-size: 0.875rem;
	}

	.intro-checks {
		display: grid;
		gap: var(--space-3);
		margin: var(--space-4) 0;
		padding: 0;
		list-style: none;
	}

	.intro-checks li {
		display: flex;
		align-items: flex-start;
		gap: 0.85rem;
	}

	.check {
		display: grid;
		flex-shrink: 0;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		margin-top: 0.1rem;
		border-radius: var(--radius-full);
		background: var(--ibe-sage-deep);
	}

	.check svg {
		width: 0.95rem;
		height: 0.95rem;
		fill: #fff;
	}

	.intro-checks strong {
		color: var(--ibe-navy);
	}

	.intro-checks p {
		margin: 0.2rem 0 0;
		color: var(--color-text-muted);
	}

	.intro-director {
		display: flex;
		align-items: center;
		gap: var(--space-2);
		margin: 0 0 var(--space-4);
	}

	.director-photo {
		width: 3.5rem;
		height: 3.5rem;
		border-radius: var(--radius-full);
		object-fit: cover;
		object-position: center 12%;
	}

	.director-name {
		margin: 0;
		font-weight: 700;
		color: var(--ibe-navy);
	}

	.director-meta {
		margin: 0.2rem 0 0;
		font-size: 0.875rem;
		color: var(--color-text-muted);
	}

	.pillar-card,
	.pillar-panel {
		padding: var(--space-5);
		border-radius: var(--radius-xl);
	}

	.pillar-card {
		background: var(--ibe-surface);
		box-shadow: var(--shadow-sm);
	}

	.pillar-card h3,
	.pillar-panel h3 {
		margin: 0;
		font-size: 1.5rem;
	}

	.pillar-card p,
	.pillar-panel p {
		margin: var(--space-2) 0 0;
	}

	.pillar-card p {
		color: var(--color-text-muted);
	}

	.pillar-panel {
		display: grid;
		align-content: start;
		background: var(--ibe-sage-deep);
		color: #fff;
	}

	.panel-eyebrow {
		margin: 0;
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgb(255 255 255 / 0.84);
	}

	.panel-phone {
		margin: var(--space-3) 0;
		color: #fff;
		font-family: var(--font-serif);
		font-size: 1.75rem;
		font-weight: 600;
		text-decoration: none;
	}

	.pillar-panel :global(.ibe-btn) {
		background: #fff;
		color: var(--ibe-sage-deep);
	}

	.pillar-panel :global(.ibe-btn:hover) {
		background: var(--ibe-cream);
		color: var(--ibe-sage-hover);
	}

	.facts-photo {
		aspect-ratio: 4 / 3;
	}

	.facts-list {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-4);
		margin: var(--space-5) 0 var(--space-4);
		padding: 0;
		list-style: none;
	}

	.facts-value {
		margin: 0;
		font-family: var(--font-serif);
		font-size: clamp(1.75rem, 3vw, 2.25rem);
		color: var(--ibe-sage-deep);
	}

	.facts-label {
		margin: 0.25rem 0 0;
		color: var(--color-text-muted);
	}

	@media (min-width: 64rem) {
		.intro-grid,
		.facts-grid {
			grid-template-columns: 1fr 1fr;
			align-items: center;
			gap: var(--space-8);
		}

		.pillars-grid {
			grid-template-columns: 1fr 1fr 1fr;
			align-items: stretch;
		}

		.intro-media {
			min-height: 34rem;
		}

		.intro-main {
			width: 78%;
			margin-right: 0;
		}

		.intro-secondary {
			display: block;
			position: absolute;
			left: 0;
			bottom: 2.5rem;
			width: 42%;
			box-shadow: var(--shadow-lg);
		}

		.intro-secondary .intro-photo {
			aspect-ratio: 4 / 3;
		}

		.intro-badge {
			left: 38%;
			bottom: 1rem;
		}
	}
</style>
