---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Breadcrumb from '../components/ui/Breadcrumb.astro';
import PageHero from '../components/ui/PageHero.astro';
import site from '../data/site.json';

const team = (await getCollection('team')).sort((a, b) => {
	const order = (id: string) => (id.includes('ricardo') ? 0 : id.includes('daniele') ? 1 : 2);
	return order(a.id) - order(b.id);
});

const description = `Conheça ${team
	.map((member) => `${member.data.name} (${member.data.specialties.join(', ')})`)
	.join(' e ')} no Instituto do Bem Estar, em São Caetano do Sul.`;

const people = {
	'@context': 'https://schema.org',
	'@graph': team.map((member) => ({
		'@type': 'Person',
		name: member.data.name,
		jobTitle: 'Fisioterapeuta',
		description: member.data.bio,
		image: new URL(member.data.photo.src, Astro.site).href,
		worksFor: {
			'@type': 'Organization',
			name: site.name,
			url: Astro.site?.href,
		},
		sameAs: [member.data.socials?.facebook, member.data.socials?.youtube].filter(Boolean),
	})),
};
---

<BaseLayout title="Nossa Equipe - Instituto do Bem Estar" description={description} canonical="/equipe/">
	<Fragment slot="head">
		<script type="application/ld+json" set:html={JSON.stringify(people)} />
	</Fragment>

	<PageHero id="equipe-pagina" title="Nossa Equipe" tone="dark">
		<Breadcrumb
			slot="breadcrumb"
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Equipe', href: '/equipe/' },
			]}
		/>
	</PageHero>

	<section class="page" aria-label="Lista da equipe">
		<Container>
			<ul class="team-list">
				{
					team.map((member, index) => (
						<li>
							<article class="member">
								<div class="member-media">
									<Image
										src={member.data.photo}
										alt={`Retrato profissional de ${member.data.name}`}
										width={640}
										height={800}
										format="webp"
										quality="mid"
										loading={index === 0 ? 'eager' : 'lazy'}
										fetchpriority={index === 0 ? 'high' : 'auto'}
										decoding="async"
										class:list={[
											'member-photo',
											member.id.includes('daniele') && 'is-daniele',
											member.id.includes('ricardo') && 'is-ricardo',
										]}
									/>
									{(member.data.socials?.facebook || member.data.socials?.youtube) && (
										<ul class="socials">
											{member.data.socials.facebook && (
												<li>
													<a
														href={member.data.socials.facebook}
														target="_blank"
														rel="noopener noreferrer"
														aria-label={`Facebook de ${member.data.name}`}
													>
														<svg viewBox="0 0 24 24" aria-hidden="true">
															<path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h3l1-3h-4V9c0-.6.4-1 1-1Z" />
														</svg>
													</a>
												</li>
											)}
											{member.data.socials.youtube && (
												<li>
													<a
														href={member.data.socials.youtube}
														target="_blank"
														rel="noopener noreferrer"
														aria-label={`YouTube de ${member.data.name}`}
													>
														<svg viewBox="0 0 24 24" aria-hidden="true">
															<path d="M23 12.2s0-3.2-.4-4.6c-.2-.9-.9-1.6-1.8-1.8C19.2 5.4 12 5.4 12 5.4s-7.2 0-8.8.4c-.9.2-1.6.9-1.8 1.8C1 9 1 12.2 1 12.2s0 3.2.4 4.6c.2.9.9 1.6 1.8 1.8 1.6.4 8.8.4 8.8.4s7.2 0 8.8-.4c.9-.2 1.6-.9 1.8-1.8.4-1.4.4-4.6.4-4.6ZM9.8 15.5v-6.7l6 3.4-6 3.3Z" />
														</svg>
													</a>
												</li>
											)}
										</ul>
									)}
								</div>
								<div class="member-copy">
									<h2>{member.data.name}</h2>
									<p>CREFITO {member.data.crefito}</p>
									<p>{member.data.specialties.join(' · ')}</p>
								</div>
							</article>
						</li>
					))
				}
			</ul>
		</Container>
	</section>
</BaseLayout>

<style>
	.page {
		padding-block: var(--space-7) var(--space-8);
		background: var(--ibe-surface);
	}

	.team-list {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-5);
		margin: 0 auto;
		padding: 0;
		list-style: none;
	}

	.member {
		height: 100%;
		padding: 0.85rem;
		border-radius: var(--radius-xl);
		background: var(--ibe-surface);
		box-shadow: var(--shadow-md);
	}

	.member-media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--ibe-bg-alt);
	}

	.member-photo {
		display: block;
		width: 100%;
		aspect-ratio: 4 / 5;
		object-fit: cover;
		object-position: center 18%;
	}

	.member-photo.is-daniele {
		object-position: center 8%;
	}

	.member-photo.is-ricardo {
		object-position: center 32%;
	}

	.socials {
		position: absolute;
		inset: 0;
		z-index: 1;
		display: flex;
		align-items: flex-end;
		justify-content: center;
		gap: 0.65rem;
		margin: 0;
		padding: 0 0 1.25rem;
		list-style: none;
		background: linear-gradient(180deg, transparent 42%, rgb(42 49 64 / 0.72) 100%);
		opacity: 1;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: var(--radius-full);
		background: var(--ibe-surface);
		color: var(--ibe-navy);
	}

	.socials svg {
		width: 1rem;
		height: 1rem;
		fill: currentColor;
	}

	.socials a:hover,
	.socials a:focus-visible {
		background: var(--ibe-sage-deep);
		color: #fff;
	}

	.member-copy {
		padding: var(--space-3) 0.35rem 0.5rem;
	}

	.member h2 {
		margin: 0;
		font-size: 1.25rem;
	}

	.member-copy p {
		margin: 0.35rem 0 0;
		font-size: 0.875rem;
		line-height: 1.5;
		color: var(--color-text-muted);
	}

	@media (hover: hover) and (pointer: fine) {
		.socials {
			opacity: 0;
			transition: opacity 0.2s ease;
		}

		.member:hover .socials,
		.member:focus-within .socials {
			opacity: 1;
		}
	}

	@media (min-width: 48rem) {
		.team-list {
			grid-template-columns: repeat(2, minmax(0, 1fr));
			max-width: 52rem;
			margin-inline: auto;
		}
	}
</style>
