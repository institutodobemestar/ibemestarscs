---
import { Image } from 'astro:assets';
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import PageHero from '../../components/ui/PageHero.astro';
import { resolveContentImage } from '../../lib/content-images';
import { getPostCategory, getPublishedPosts } from '../../lib/blog';

export async function getStaticPaths({ paginate }) {
	const posts = await getPublishedPosts();
	return paginate(posts, { pageSize: 9 });
}

interface Props {
	page: Page<CollectionEntry<'blog'>>;
}

const { page } = Astro.props;
const canonical = page.currentPage === 1 ? '/blog/' : `/blog/${page.currentPage}/`;
const pageHref = (n: number) => (n === 1 ? '/blog/' : `/blog/${n}/`);
const pages = Array.from({ length: page.lastPage }, (_, index) => index + 1);
---

<BaseLayout
	title="Blog - Instituto do Bem Estar"
	description="Artigos sobre saúde, bem-estar, fisioterapia e reabilitação escritos pela equipe do Instituto do Bem Estar em São Caetano do Sul."
	canonical={canonical}
>
	<PageHero id="blog-titulo" title="Nosso Blog" tone="dark">
		<Breadcrumb
			slot="breadcrumb"
			items={[
				{ label: 'Home', href: '/' },
				{ label: 'Blog', href: '/blog/' },
			]}
		/>
	</PageHero>
	<section class="page" aria-label="Lista de artigos">
		<Container>
			<ul class="post-grid">
				{
					page.data.map((post, index) => {
						const isLcpCandidate = page.currentPage === 1 && index === 0;
						const category = getPostCategory(post);
						return (
							<li>
								<a href={`/blog/${post.data.slug}/`} class="post-card">
									<div class="post-media">
										<Image
											src={resolveContentImage(post.data.heroImage)}
											alt={`Capa do artigo ${post.data.title}`}
											width={960}
											height={540}
											format="webp"
											quality="mid"
											loading={isLcpCandidate ? 'eager' : 'lazy'}
											fetchpriority={isLcpCandidate ? 'high' : 'auto'}
											decoding="async"
											class="post-image"
										/>
										<span class="post-chip">{category}</span>
									</div>
									<div class="post-body">
										<h2>{post.data.title}</h2>
										<p>{post.data.description}</p>
										<span class="post-more">
											Leia mais
											<span aria-hidden="true"> →</span>
										</span>
									</div>
								</a>
							</li>
						);
					})
				}
			</ul>
			{
				page.lastPage > 1 && (
					<nav class="pagination" aria-label="Paginação do blog">
						{page.url.prev ? (
							<a class="page-arrow" href={page.url.prev} aria-label="Página anterior">
								‹
							</a>
						) : (
							<span class="page-arrow is-disabled" aria-hidden="true">
								‹
							</span>
						)}
						{pages.map((n) =>
							n === page.currentPage ? (
								<span class="page-num is-current" aria-current="page">
									{n}
								</span>
							) : (
								<a class="page-num" href={pageHref(n)}>
									{n}
								</a>
							),
						)}
						{page.url.next ? (
							<a class="page-arrow" href={page.url.next} aria-label="Próxima página">
								›
							</a>
						) : (
							<span class="page-arrow is-disabled" aria-hidden="true">
								›
							</span>
						)}
					</nav>
				)
			}
		</Container>
	</section>
</BaseLayout>

<style>
	.page {
		padding-block: var(--space-7) var(--space-8);
		background: var(--ibe-surface);
	}

	.post-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-4);
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
		padding: 0.85rem;
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--ibe-surface);
		box-shadow: var(--shadow-md);
		text-decoration: none;
		color: inherit;
	}

	.post-card:hover {
		box-shadow: var(--shadow-lg);
	}

	.post-media {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--ibe-bg-alt);
	}

	.post-image {
		display: block;
		width: 100%;
		height: 14rem;
		object-fit: cover;
	}

	.post-chip {
		position: absolute;
		top: 0.85rem;
		left: 0.85rem;
		padding: 0.35rem 0.8rem;
		border-radius: var(--radius-full);
		background: rgb(255 255 255 / 0.94);
		color: var(--ibe-navy);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.post-body {
		display: flex;
		flex: 1;
		flex-direction: column;
		padding: var(--space-3) 0.35rem 0.35rem;
	}

	.post-body h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.3;
	}

	.post-body p {
		display: -webkit-box;
		margin: 0.75rem 0 0;
		overflow: hidden;
		color: var(--color-text-muted);
		font-size: 0.9375rem;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
	}

	.post-more {
		margin-top: auto;
		padding-top: var(--space-3);
		color: var(--ibe-sage-deep);
		font-size: 0.875rem;
		font-weight: 600;
	}

	.post-card:hover h2,
	.post-card:hover .post-more {
		color: var(--ibe-sage-deep);
	}

	.pagination {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: center;
		gap: 0.55rem;
		margin-top: var(--space-6);
	}

	.page-arrow,
	.page-num {
		display: grid;
		place-items: center;
		min-width: 2.5rem;
		height: 2.5rem;
		padding: 0 0.65rem;
		border-radius: var(--radius-full);
		background: var(--ibe-bg-alt);
		color: var(--ibe-navy);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}

	.page-num.is-current {
		background: var(--ibe-sage-deep);
		color: #fff;
	}

	.page-arrow.is-disabled {
		opacity: 0.4;
	}

	.page-arrow:not(.is-disabled):hover,
	.page-num:not(.is-current):hover {
		background: var(--ibe-primary-soft);
	}

	@media (min-width: 48rem) {
		.post-grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	@media (min-width: 64rem) {
		.post-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			gap: var(--space-5);
		}
	}
</style>
